<view class="container"><view class="header"><view class="header-content"><text class="project-name">{{a}}</text><text class="plan-title">{{b}}</text></view></view><scroll-view scroll-y class="material-list"><view class="upload-section"><view class="upload-btn" bindtap="{{c}}"><text class="upload-icon">+</text><text>上传资料（图片/视频）</text></view></view><view wx:if="{{d}}" class="material-cards"><view wx:for="{{e}}" wx:for-item="item" wx:key="n" class="material-card"><view wx:if="{{item.a}}" class="material-image"><image src="{{item.b}}" mode="aspectFill" bindtap="{{item.c}}"/><view class="material-type-tag image-tag">图片</view></view><view wx:elif="{{item.d}}" class="material-video"><video src="{{item.e}}" poster="{{item.f}}" controls/><view class="material-type-tag video-tag">视频</view><view wx:if="{{item.g}}" class="video-duration">{{item.h}}</view></view><view class="material-info"><text class="material-title">{{item.i}}</text><text wx:if="{{item.j}}" class="material-desc">{{item.k}}</text><text class="material-time">{{item.l}}</text></view><view class="material-actions"><text class="delete-btn" bindtap="{{item.m}}">删除</text></view></view></view><view wx:else class="empty-state"><text class="empty-icon">📎</text><text class="empty-text">暂无资料</text><text class="empty-tip">点击上方按钮上传图片或视频</text></view></scroll-view><view wx:if="{{f}}" class="modal-mask" bindtap="{{x}}"><view class="modal-content" catchtap="{{w}}"><view class="modal-header"><text class="modal-title">上传资料</text><text class="modal-close" bindtap="{{g}}">×</text></view><view class="modal-body"><view wx:if="{{h}}" class="file-preview"><image wx:if="{{i}}" src="{{j}}" mode="aspectFit"/><video wx:else src="{{k}}" controls/></view><view class="form-item"><text class="form-label">资料类型</text><picker mode="selector" range="{{m}}" value="{{n}}" bindchange="{{o}}"><view class="form-picker">{{l}}</view></picker></view><view class="form-item"><text class="form-label">标题（可选）</text><input class="form-input" placeholder="如：正手高远球动作示范" value="{{p}}" bindinput="{{q}}"/></view><view class="form-item"><text class="form-label">描述（可选）</text><block wx:if="{{r0}}"><textarea class="form-textarea" placeholder="请输入资料描述" value="{{r}}" bindinput="{{s}}"/></block></view></view><view class="modal-footer"><button class="btn-cancel" bindtap="{{t}}">取消</button><button class="btn-confirm" bindtap="{{v}}">上传</button></view></view></view></view>