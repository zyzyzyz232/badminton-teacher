<view class="container"><view class="nav-bar" style="{{'padding-top:' + b}}"><view class="nav-back" bindtap="{{a}}"><text class="nav-back-icon">‹</text><text class="nav-back-text">返回</text></view><text class="nav-title">资料管理</text><view class="nav-placeholder"/></view><view class="header"><view class="header-content"><text class="project-name">{{c}}</text><text class="plan-title">{{d}}</text></view></view><scroll-view scroll-y class="material-list" style="{{'height:' + j}}"><view class="upload-section"><view class="upload-type-row"><text class="upload-type-label">上传资料类型</text><view class="type-segment type-segment-inline"><view wx:for="{{e}}" wx:for-item="label" wx:key="b" class="{{['type-segment-item', label.c && 'active']}}" bindtap="{{label.d}}">{{label.a}}</view></view></view><view class="upload-btn" bindtap="{{g}}"><text class="upload-icon">+</text><text>上传{{f}}</text></view></view><view wx:if="{{h}}" class="material-cards"><view wx:for="{{i}}" wx:for-item="item" wx:key="o" class="material-card"><view wx:if="{{item.a}}" class="material-image"><image src="{{item.b}}" mode="aspectFill" bindtap="{{item.c}}"/><view class="material-type-tag image-tag">图片</view></view><view wx:elif="{{item.d}}" class="material-video"><video src="{{item.e}}" poster="{{item.f}}" controls/><view class="material-type-tag video-tag">视频</view><view wx:if="{{item.g}}" class="video-duration">{{item.h}}</view></view><view class="material-info"><text class="material-title">{{item.i}}</text><text wx:if="{{item.j}}" class="material-desc">{{item.k}}</text><text class="material-time">{{item.l}}</text></view><view class="material-actions"><text class="action-btn type-btn" bindtap="{{item.m}}">修改类型</text><text class="action-btn delete-btn" bindtap="{{item.n}}">删除</text></view></view></view><view wx:else class="empty-state"><text class="empty-icon">📎</text><text class="empty-text">暂无资料</text><text class="empty-tip">点击上方按钮上传图片或视频</text></view></scroll-view><view wx:if="{{k}}" class="modal-mask" bindtap="{{z}}"><view class="modal-content" catchtap="{{y}}"><view class="modal-header"><text class="modal-title">上传资料</text><text class="modal-close" bindtap="{{l}}">×</text></view><view class="modal-body"><view wx:if="{{m}}" class="file-preview"><image wx:if="{{n}}" src="{{o}}" mode="aspectFit"/><video wx:else src="{{p}}" controls/></view><view class="form-item"><text class="form-label">资料类型</text><view class="type-segment"><view wx:for="{{q}}" wx:for-item="label" wx:key="b" class="{{['type-segment-item', label.c && 'active']}}" catchtap="{{label.d}}">{{label.a}}</view></view></view><view class="form-item"><text class="form-label">标题（可选）</text><input class="form-input" placeholder="如：正手高远球动作示范" value="{{r}}" bindinput="{{s}}"/></view><view class="form-item"><text class="form-label">描述（可选）</text><block wx:if="{{r0}}"><textarea class="form-textarea" placeholder="请输入资料描述" value="{{t}}" bindinput="{{v}}"/></block></view></view><view class="modal-footer"><button class="btn-cancel" bindtap="{{w}}">取消</button><button class="btn-confirm" bindtap="{{x}}">上传</button></view></view></view></view>