/* 页面容器：浅灰背景 */
.page-container.data-v-1cf27b2a {
  min-height: 100vh;
  background-color: #f5f7fa;
  position: relative;
  overflow: hidden;
}

/* 顶部绿色背景区 */
.top-bg.data-v-1cf27b2a {
  height: 420rpx;
  background: linear-gradient(135deg, #07c160, #0ebf8c);
  /* 微信绿渐变 */
  position: relative;
  border-bottom-left-radius: 60rpx;
  border-bottom-right-radius: 60rpx;
  padding-top: 100rpx;
  box-sizing: border-box;
}

/* 顶部装饰圆 */
.circle-bg.data-v-1cf27b2a {
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}
.header-text-area.data-v-1cf27b2a {
  padding-left: 60rpx;
  color: #fff;
}
.app-name.data-v-1cf27b2a {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}
.welcome-text.data-v-1cf27b2a {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 卡片容器：向上重叠 */
.card-container.data-v-1cf27b2a {
  margin-top: -120rpx;
  /* 向上移动，盖住背景 */
  padding: 0 40rpx;
}
.form-box.data-v-1cf27b2a {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.05);
}
.form-title.data-v-1cf27b2a {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
  text-align: center;
}

/* 输入框样式优化 */
.input-item.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  background-color: #f7f8fa;
  /* 浅灰底色 */
  border-radius: 50rpx;
  /* 全圆角 */
  padding: 0 30rpx;
  margin-bottom: 30rpx;
  height: 100rpx;
  transition: all 0.3s;
}
.input-item.data-v-1cf27b2a:active {
  background-color: #edf0f5;
}
.icon-box.data-v-1cf27b2a {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 50rpx;
  text-align: center;
}
.input.data-v-1cf27b2a {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  height: 100%;
}
.placeholder-style.data-v-1cf27b2a {
  color: #c0c4cc;
}

/* 按钮样式 */
.submit-btn.data-v-1cf27b2a {
  margin-top: 50rpx;
  background: linear-gradient(90deg, #07c160, #1aad19);
  color: white;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  height: 90rpx;
  line-height: 90rpx;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}
.submit-btn.data-v-1cf27b2a::after {
  border: none;
}
.btn-hover.data-v-1cf27b2a {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 底部切换区 */
.toggle-area.data-v-1cf27b2a {
  margin-top: 30rpx;
  text-align: center;
  font-size: 28rpx;
}
.toggle-tips.data-v-1cf27b2a {
  color: #909399;
}
.toggle-btn.data-v-1cf27b2a {
  color: #07c160;
  font-weight: bold;
  margin-left: 10rpx;
  padding: 10rpx;
}

/* 第三方登录 */
.footer-area.data-v-1cf27b2a {
  margin-top: 80rpx;
  text-align: center;
}
.divider.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}
.divider .divider-text.data-v-1cf27b2a {
  font-size: 24rpx;
  color: #ccc;
  background-color: #f5f7fa;
  padding: 0 20rpx;
  position: relative;
  z-index: 1;
}
.divider.data-v-1cf27b2a::after {
  content: "";
  position: absolute;
  width: 60%;
  height: 1px;
  background-color: #e0e0e0;
  z-index: 0;
}
.wx-login-btn.data-v-1cf27b2a {
  background-color: #fff;
  color: #333;
  font-size: 28rpx;
  border-radius: 50rpx;
  width: 60%;
  border: 1px solid #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  height: 80rpx;
}
.wx-login-btn .wx-icon.data-v-1cf27b2a {
  margin-right: 10rpx;
  font-size: 32rpx;
  color: #07c160;
}
.wx-login-btn.data-v-1cf27b2a::after {
  border: none;
}