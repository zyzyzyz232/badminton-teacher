  display: flex;
  align-items: center;
  justify-content: center;
}
.course-info.data-v-ec6960e7 {
  text-align: center;
  color: #fff;
}
.course-name.data-v-ec6960e7 {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}
.course-class.data-v-ec6960e7 {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 内容区域 */
.content-area.data-v-ec6960e7 {
  padding: 30rpx;
  margin-top: -60rpx;
}

/* 信息卡片 */
.info-card.data-v-ec6960e7 {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.info-card .card-title.data-v-ec6960e7 {
