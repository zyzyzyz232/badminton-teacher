/* 操作卡片 */
.action-card.data-v-ef848c8e {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.action-title.data-v-ef848c8e {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}
.action-buttons.data-v-ef848c8e {
  display: flex;
  justify-content: space-around;
}
.action-btn.data-v-ef848c8e {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 50rpx;
  border-radius: 20rpx;
  min-width: 240rpx;
}
.action-btn.data-v-ef848c8e:active {
  opacity: 0.9;
  transform: scale(0.98);
}
.action-btn.primary.data-v-ef848c8e {
  background: linear-gradient(135deg, #07c160, #0ebf8c);
}
.action-btn.secondary.data-v-ef848c8e {
