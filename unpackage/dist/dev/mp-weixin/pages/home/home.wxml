<view class="page-container data-v-07e72d3c"><view class="welcome-bar data-v-07e72d3c"><text class="welcome-text data-v-07e72d3c">欢迎回来，{{a}}</text></view><view class="content-area data-v-07e72d3c"><view class="section-header data-v-07e72d3c"><text class="section-title data-v-07e72d3c">选择班级上课</text><text class="section-subtitle data-v-07e72d3c">共 {{b}} 个班级</text></view><view wx:if="{{c}}" class="course-groups data-v-07e72d3c"><view wx:for="{{d}}" wx:for-item="course" wx:key="f" class="course-section data-v-07e72d3c"><view class="course-header-bar data-v-07e72d3c"><text class="course-title data-v-07e72d3c">{{course.a}}</text><text class="course-class-tag data-v-07e72d3c">{{course.b}}</text></view><view class="class-list data-v-07e72d3c"><view wx:for="{{course.c}}" wx:for-item="cls" wx:key="c" class="class-card data-v-07e72d3c" bindtap="{{cls.d}}"><view class="class-header data-v-07e72d3c"><text class="class-name data-v-07e72d3c">{{cls.a}}</text><text class="student-count data-v-07e72d3c">{{cls.b}} 人</text></view><view class="class-info data-v-07e72d3c"><view class="info-row data-v-07e72d3c"><text class="info-label data-v-07e72d3c">学期：</text><text class="info-value data-v-07e72d3c">{{course.d}}</text></view><view class="info-row data-v-07e72d3c"><text class="info-label data-v-07e72d3c">时间：</text><text class="info-value data-v-07e72d3c">{{course.e}}</text></view></view><view class="class-arrow data-v-07e72d3c"><text class="arrow-icon data-v-07e72d3c">&gt;</text></view></view></view></view></view><view wx:else class="empty-state data-v-07e72d3c"><text class="empty-icon data-v-07e72d3c">📚</text><text class="empty-text data-v-07e72d3c">还没有班级</text><text class="empty-subtitle data-v-07e72d3c">请先创建课程并添加班级</text><view class="action-btns data-v-07e72d3c"><button class="create-btn data-v-07e72d3c" bindtap="{{e}}">去创建课程</button></view></view></view></view>