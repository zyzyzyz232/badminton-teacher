/* 文章场景相关 */
.page-container.data-v-07e72d3c {
  min-height: 100vh;
  background-color: #f5f7fa;
}

/* 简洁的欢迎栏 */
.welcome-bar.data-v-07e72d3c {
  background: linear-gradient(135deg, #07c160, #0ebf8c);
  padding: 30rpx 40rpx;
  display: flex;
  align-items: center;
}
.welcome-text.data-v-07e72d3c {
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
}

/* 内容区域 */
.content-area.data-v-07e72d3c {
  padding: 30rpx;
}
.section-header.data-v-07e72d3c {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-header .section-title.data-v-07e72d3c {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.section-header .section-subtitle.data-v-07e72d3c {
  font-size: 26rpx;
  color: #999;
}

/* 课程分组 */
.course-groups .course-section.data-v-07e72d3c {
  margin-bottom: 30rpx;
}
.course-groups .course-header-bar.data-v-07e72d3c {
  background: linear-gradient(135deg, #07c160, #0ebf8c);
  padding: 24rpx 30rpx;
  border-radius: 16rpx 16rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.course-groups .course-header-bar .course-title.data-v-07e72d3c {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}
.course-groups .course-header-bar .course-class-tag.data-v-07e72d3c {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background-color: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 班级卡片 */
.class-list .class-card.data-v-07e72d3c {
  background-color: #fff;
  border-radius: 0 0 16rpx 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  position: relative;
}
.class-list .class-card.data-v-07e72d3c:active {
  opacity: 0.9;
}
.class-list .class-header.data-v-07e72d3c {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.class-list .class-header .class-name.data-v-07e72d3c {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.class-list .class-header .student-count.data-v-07e72d3c {
  font-size: 24rpx;
  color: #07c160;
  background-color: #f0f9eb;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}
.class-list .class-info .info-row.data-v-07e72d3c {
  display: flex;
  margin-bottom: 8rpx;
}
.class-list .class-info .info-row.data-v-07e72d3c:last-child {
  margin-bottom: 0;
}
.class-list .class-info .info-row .info-label.data-v-07e72d3c {
  font-size: 26rpx;
  color: #999;
  width: 100rpx;
}
.class-list .class-info .info-row .info-value.data-v-07e72d3c {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}
.class-list .class-arrow.data-v-07e72d3c {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
}
.class-list .class-arrow .arrow-icon.data-v-07e72d3c {
  font-size: 32rpx;
  color: #ccc;
}

/* 空状态 */
.empty-state.data-v-07e72d3c {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}
.empty-state .empty-icon.data-v-07e72d3c {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}
.empty-state .empty-text.data-v-07e72d3c {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}
.empty-state .empty-subtitle.data-v-07e72d3c {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 50rpx;
}
.empty-state .action-btns.data-v-07e72d3c {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.empty-state .create-btn.data-v-07e72d3c {
  background: linear-gradient(135deg, #07c160, #0ebf8c);
  color: #fff;
  font-size: 32rpx;
  padding: 28rpx 0;
  border-radius: 12rpx;
  border: none;
  width: 80%;
}
.empty-state .create-btn.data-v-07e72d3c:active {
  opacity: 0.9;
}
.empty-state .create-btn.data-v-07e72d3c::after {
  display: none;
}