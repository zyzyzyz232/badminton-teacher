
.page.data-v-be437309 {
	min-height: 100vh;
	background: #f5f7fa;
	display: flex;
	flex-direction: column;
	/* 底部按钮区 + 原生 tabBar（约 100rpx） */
	padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
	box-sizing: border-box;
}
.header-bar.data-v-be437309 {
	background: linear-gradient(135deg, #07c160, #0ebf8c);
	padding: 8rpx 32rpx 32rpx;
	color: #fff;
}
.title.data-v-be437309 {
	font-size: 40rpx;
	font-weight: 700;
	display: block;
	margin-bottom: 8rpx;
}
.sub.data-v-be437309 {
	font-size: 24rpx;
	opacity: 0.92;
	display: block;
}
.list-wrap.data-v-be437309 {
	flex: 1;
	padding: 24rpx;
	box-sizing: border-box;
	max-height: calc(100vh - 200rpx);
}
.plan-card.data-v-be437309 {
	background: #fff;
	border-radius: 20rpx;
	padding: 28rpx 24rpx;
	margin-bottom: 20rpx;
	box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.plan-card.data-v-be437309:active {
	opacity: 0.92;
}
.row-top.data-v-be437309 {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 16rpx;
}
.plan-name.data-v-be437309 {
	font-size: 32rpx;
	font-weight: 600;
	color: #333;
	flex: 1;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.row-actions.data-v-be437309 {
	display: flex;
	align-items: center;
	gap: 16rpx;
	flex-shrink: 0;
}
.plan-delete-btn.data-v-be437309 {
	font-size: 24rpx;
	color: #ff4d4f;
	padding: 6rpx 16rpx;
	border: 1rpx solid #ffccc7;
	border-radius: 8rpx;
	background: #fff2f0;
}
.arrow.data-v-be437309 {
	font-size: 40rpx;
	color: #ccc;
	line-height: 1;
}
.plan-sub.data-v-be437309 {
	display: block;
	margin-top: 12rpx;
	font-size: 24rpx;
	color: #999;
}
.empty.data-v-be437309 {
	padding: 80rpx 32rpx;
	text-align: center;
}
.empty-title.data-v-be437309 {
	font-size: 30rpx;
	color: #666;
	display: block;
	margin-bottom: 12rpx;
}
.empty-tip.data-v-be437309 {
	font-size: 24rpx;
	color: #bbb;
	display: block;
}
.fab-wrap.data-v-be437309 {
	position: fixed;
	left: 0;
	right: 0;
	/* 上移至 tabBar 上方（高度约 100rpx） */
	bottom: calc(100rpx + env(safe-area-inset-bottom));
	padding: 16rpx 28rpx 16rpx;
	background: #fff;
	box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}
.new-btn.data-v-be437309 {
	margin: 0;
	height: 88rpx;
	line-height: 88rpx;
	font-size: 30rpx;
	border-radius: 44rpx;
	background: linear-gradient(135deg, #07c160, #0ebf8c);
	border: none;
}
.new-btn.data-v-be437309::after {
	display: none;
}
