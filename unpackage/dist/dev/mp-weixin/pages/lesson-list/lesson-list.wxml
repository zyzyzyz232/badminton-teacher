<view class="page-container data-v-18fa740d"><view class="top-bg data-v-18fa740d"><view class="lesson-info data-v-18fa740d"><text class="class-name data-v-18fa740d">{{a}}</text><text class="subtitle data-v-18fa740d">{{b}}</text></view></view><view class="content-area data-v-18fa740d"><view class="create-section data-v-18fa740d"><view class="section-title data-v-18fa740d"><text class="icon data-v-18fa740d">📅</text><text class="data-v-18fa740d">{{c}}</text></view><view wx:if="{{d}}" class="create-btn data-v-18fa740d" bindtap="{{e}}"><text class="create-icon data-v-18fa740d">+</text><text class="data-v-18fa740d">创建课堂</text></view></view><view wx:if="{{f}}" class="lesson-list data-v-18fa740d"><view wx:for="{{g}}" wx:for-item="item" wx:key="k" class="lesson-card data-v-18fa740d"><view class="card-main data-v-18fa740d" catchtap="{{item.h}}"><view class="lesson-header data-v-18fa740d"><view class="lesson-week data-v-18fa740d"><text class="week-num data-v-18fa740d">第{{item.a}}周</text><text class="lesson-type data-v-18fa740d">{{item.b}}</text></view><text class="{{['lesson-status', 'data-v-18fa740d', item.d]}}">{{item.c}}</text></view><view class="lesson-time data-v-18fa740d"><text class="time-icon data-v-18fa740d">🕐</text><text class="time-text data-v-18fa740d">{{item.e}} - {{item.f}}</text></view><view class="lesson-footer data-v-18fa740d"><text class="teacher-name data-v-18fa740d">授课教师：{{item.g}}</text></view></view><view class="card-actions data-v-18fa740d"><view wx:if="{{h}}" class="action-btn delete data-v-18fa740d" catchtap="{{item.i}}"><text class="data-v-18fa740d">删除</text></view><view class="action-btn enter data-v-18fa740d" catchtap="{{item.j}}"><text class="data-v-18fa740d">{{i}}</text></view></view></view></view><view wx:else class="empty-state data-v-18fa740d"><text class="empty-icon data-v-18fa740d">📭</text><text class="empty-text data-v-18fa740d">暂无课堂</text><text class="empty-tip data-v-18fa740d">点击上方"创建课堂"按钮添加</text></view></view></view>