.page-container.data-v-5fee218d {
  min-height: 100vh;
  background-color: #f5f7fa;
}

/* 顶部区域 */
.top-bg.data-v-5fee218d {
  height: 220rpx;
  background: linear-gradient(135deg, #07c160, #0ebf8c);
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.course-info.data-v-5fee218d {
  text-align: center;
  color: #fff;
}
.course-name.data-v-5fee218d {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
}
.subtitle.data-v-5fee218d {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 内容区域 */
.content-area.data-v-5fee218d {
  padding: 30rpx;
  margin-top: -30rpx;
}
.section-title.data-v-5fee218d {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}
.section-title .icon.data-v-5fee218d {
  margin-right: 10rpx;
}

/* 班级卡片 */
.class-list .class-card.data-v-5fee218d {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
