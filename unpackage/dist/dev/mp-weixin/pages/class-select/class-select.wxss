  display: flex;
  align-items: center;
  justify-content: space-between;
}
.class-list .class-card.data-v-5fee218d:active {
  opacity: 0.9;
}
.class-list .class-info.data-v-5fee218d {
  flex: 1;
}
.class-list .class-info .class-name.data-v-5fee218d {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}
.class-list .class-info .student-count.data-v-5fee218d {
  display: flex;
  align-items: center;
}
