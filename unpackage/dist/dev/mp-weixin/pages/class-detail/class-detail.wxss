  font-size: 60rpx;
  margin-bottom: 16rpx;
}
.action-btn .btn-text.data-v-ef848c8e {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.action-btn.primary .btn-text.data-v-ef848c8e {
  color: #fff;
}
.action-btn.secondary .btn-text.data-v-ef848c8e {
  color: #666;
}
.action-btn .btn-desc.data-v-ef848c8e {
  font-size: 22rpx;
}
.action-btn.primary .btn-desc.data-v-ef848c8e {
  color: rgba(255, 255, 255, 0.8);
}
.action-btn.secondary .btn-desc.data-v-ef848c8e {
  color: #999;
}

